PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/meet
JWT_SECRET=change-me
WX_APPID=your-wechat-mini-program-appid
WX_APPSECRET=your-wechat-mini-program-secret
BASE_URL=http://localhost:3000
SMOKE_BASE_URL=http://localhost:3000

# 决策数据裁剪开关：默认 true。旧版前端未升级期间可临时设为 false，
# 让非管理员也能拿到他人的时段（否则旧版会把「N 人已填写」显示成 1）。
REDACT_DECISION=true

# 接口限流（每分钟每 IP），不配置时默认 login=60、upload=20、telemetry=240
LOGIN_RATE_LIMIT=60
UPLOAD_RATE_LIMIT=20
TELEMETRY_RATE_LIMIT=240

# 调试身份通道：开启后可用 code="__debug__:<openid>" 登录任意身份。
# 仅在需要验证「全新用户视角」时临时打开，用完改回 false。
ENABLE_DEBUG_IDENTITY=false

# 跨域白名单，逗号分隔；不配置 = 拒绝所有跨域请求（小程序原生请求不带 Origin，不受影响）
# 本地浏览器调试需要时填 http://localhost:10086 之类，或填 * 完全放开
CORS_ORIGINS=
